# Copy to .env and fill in. Only Demo 2's live mode needs these.
GEMINI_API_KEY=your_key_here

# Optional: model for Demo 2 (default: gemini-3.5-flash)
DEMO_MODEL=gemini-3.5-flash

# Optional: on-device model for --local (default: qwen2.5-coder:3b)
LOCAL_MODEL=qwen2.5-coder:3b

# Optional: attempts per run (default: 6)
DEMO_ATTEMPTS=6
